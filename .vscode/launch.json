{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Platform: FastAPI backend (:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "Platform: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-q"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "Legacy Node: Monitor (:3000)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/monitor.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Legacy Node: Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test/api.test.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
