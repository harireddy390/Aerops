# ---- AeroOps platform ----
APP_ENV=development
DATABASE_URL=sqlite:///./aeroops.db

# Local AI (Ollama). Optional: rules always work without it.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SEC=45

# Cloud AI primary (optional). Falls back to Ollama, then rules.
# Put the real key in backend/.env (gitignored), never in code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=30

# Gmail incident emails (optional). Create a Google App Password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=AeroOps <you@gmail.com>
MAIL_TO=you@gmail.com

# Monitoring defaults
DEFAULT_HEALTH_INTERVAL=5
MAX_RESTART_ATTEMPTS=3
MONITOR_ENABLED=true
SEED_DEMOS=true

# Webhook for crash notifications (Discord/Slack compatible)
ALERT_WEBHOOK=

# Auth: first registered user becomes admin, then registration closes.
AUTH_ENABLED=true
JWT_SECRET=change-this-to-a-long-random-string

# ---- Legacy Node MVP (root server.js/monitor.js) ----
# PORT=3000 (legacy config.json)
